{
  "name": "pi-lean-edit",
  "version": "0.3.1",
  "description": "Safer, cheaper edits by verifying prior reads in the harness instead of the prompt. Lets the harness verify the model already read the latest text it wants to edit, avoiding old-text replay and hash-decorated reads.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "lean-edit"
  ],
  "exports": "./index.ts",
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiobonfiglio/pi-lean-edit.git"
  },
  "homepage": "https://github.com/sergiobonfiglio/pi-lean-edit#readme",
  "bugs": {
    "url": "https://github.com/sergiobonfiglio/pi-lean-edit/issues"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "pack:dry": "npm pack --dry-run",
    "release:check": "npm run check && npm run test && npm run pack:dry",
    "publish:public": "npm publish --access public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "typebox": "*"
  },
  "dependencies": {
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
