{
  "name": "pi-smart-edit",
  "version": "0.1.0",
  "description": "Pi extension adding snapshot-verified range edits for read/edit.",
  "type": "module",
  "keywords": ["pi-package", "pi", "extension", "smart-edit"],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "pack:dry": "npm pack --dry-run",
    "release:check": "npm run check && npm run test && npm run pack:dry",
    "publish:public": "npm publish --access public"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
